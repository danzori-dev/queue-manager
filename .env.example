# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_OWNER_ID=

SQLITE_DSN=
SQLITE_AUTH_TOKEN=

# Optional. Defaults are shown.

# TELEGRAM_API_TIMEOUT=10s

# TELEGRAM_MODE=polling

# TELEGRAM_RETRY_MAX_ATTEMPTS=3
# TELEGRAM_RETRY_EXPONENT_BASE=2.0
# TELEGRAM_RETRY_START_DELAY=500ms
# TELEGRAM_RETRY_MAX_DELAY=8s

# TELEGRAM_POLL_TIMEOUT=30s
# TELEGRAM_POLL_RETRY_TIMEOUT=5s
# TELEGRAM_POLL_STOP_TIMEOUT=10s
# TELEGRAM_POLL_RECONNECT_DELAY=10s

# Required when TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_URL=https://example.com
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_WEBHOOK_LISTEN=:8080

# SQLITE_QUERY_TIMEOUT=5s

# RENDER_DEBOUNCE=1s
# RENDER_MIN_INTERVAL=3s
# RENDER_RETRY_DELAY=5s
# RENDER_MAX_ATTEMPTS=5

# LOG_LEVEL=info
# LOG_FORMAT=json

# CLEANUP_RETENTION=720h
# CLEANUP_INTERVAL=24h

# RATE_LIMIT_STUDENT_BURST=3
# RATE_LIMIT_STUDENT_INTERVAL=3s
# RATE_LIMIT_ADMIN_BURST=5
# RATE_LIMIT_ADMIN_INTERVAL=3s

# REQUEST_LIMIT_WINDOW=10m
